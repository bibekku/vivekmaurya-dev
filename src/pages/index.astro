---
import BaseLayout from '../layouts/BaseLayout.astro';

const randomWelcomeMessages = [
  "please leave your shoes at the door",
  "no, this isn't sparta. but it is spartan (adj. minimalist and functional)",
  "wilkommen! bienvenue! welcome!",
  "the elves are hard at work, feel free to look around",
  "warm yourself by the fire, and stay a while, o weary traveler",
  "hey you, you're finally awake. you were trying to cross the border, right? walked right into that imperial ambush, same as us, and that thief over there",
  "feel free to take a chimney. don't worry, it's on the house.",
  "here be no dragons, maybe a few bugs",
  "ai slop free since 2026",
  "have YOU got a 99% win rate in wordle? nah, didn't think so",
  "shaders under construction, there WILL be fragments",
  "i used to write java, then i took an arrow to the knee",
  "no, you're thinking of some other vivek maurya",
  "did you know, you can hit F5 to get a new welcome message? try it!",
  "did you know, you can hit ctrl+W to get a new welcome message? try it!",
  "whoever decided flammable and inflammable should mean the same thing?",
  "TARS, set humor to 0%. this is serious stuff.",
  "they shouldn't let just anyone purchase a domain",
  "there's beer in the fridge",
  "there's no beer in the fridge",
  "there's a cat in the box, do NOT look inside",
  "make love, not war",
  "god i miss the internet",
  "not serving ai agents",
  "woah, the background's moving!",
  "god made me a copywriter but here i am writing code",
  "do not expect anything of value here, but check out the neat header!",
  "HELP! I'M TRAPPED IN THIS <H1> TAG!",
  "wow, a moving background! and it's not a video..?",
  "bots writing code writing bots writing code writing bots writing code writing bots writing...",
  "it's pronounced 'JIF' and i'll die on this hill",
];

const initial = randomWelcomeMessages[Math.floor(Math.random() * randomWelcomeMessages.length)];

---
<BaseLayout title="Vivek Maurya's Website">
  <h1 id="welcome-message">{initial}</h1>
</BaseLayout>

<script define:vars={{ randomWelcomeMessages }}>
  const el = document.getElementById('welcome-message');
  el.textContent =
    randomWelcomeMessages[Math.floor(Math.random() * randomWelcomeMessages.length)];
</script>
